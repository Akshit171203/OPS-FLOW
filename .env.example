NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:3140
DATABASE_URL=postgres://opsflow:opsflow@localhost:5455/opsflow
TEST_DATABASE_URL=postgres://opsflow:opsflow@localhost:5455/opsflow_test
REDIS_URL=redis://localhost:6390
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
QUEUE_PREFIX=opsflow
RETRY_DELAYS_MS=1000,5000,30000
WORKER_CONCURRENCY=5
# Reverse-proxy hops in front of the API (the Next.js rewrite counts as 1). Use 0 if clients hit the API directly.
TRUST_PROXY=1
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000

# AI analysis. "fake" works offline with no key (clearly labelled in the UI); "gemini" calls the real API.
AI_PROVIDER=fake
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=30000

