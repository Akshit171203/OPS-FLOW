# Production settings for the API. Copy the values into your host's environment settings
# (on Render, render.yaml already declares most of them). Never commit real values.

NODE_ENV=production
PORT=4100

# Public https address of the web app. Production refuses to start with a plain http address
# (localhost is the one exception, for running the Docker stack on your own machine).
WEB_ORIGIN=https://your-web-app.example.com

DATABASE_URL=postgres://user:password@host:5432/opsflow   # Postgres 16 with the pgvector extension
REDIS_URL=redis://host:6379                               # keep eviction off: BullMQ stores jobs here

# At least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Proxies between the browser and the API. Wrong values make rate limits and audit IPs see the proxy, not the user.
TRUST_PROXY=1
# Defaults to true in production. Only set false for http://localhost Docker runs.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Run the queue workers inside the API process (needed on hosts with no free background workers).
# With a separate worker process, leave this false and run `pnpm --filter @opsflow/backend worker`.
EMBEDDED_WORKERS=false

# Public demo. Leave false for a real deployment.
DEMO_MODE=false
DEMO_RESET_HOURS=12   # re-seed demo data this often; 0 turns the reset off

# AI analysis. "fake" is offline and free; "gemini" calls the real API.
AI_PROVIDER=fake
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=30000
AI_DAILY_CAP=200      # new analyses per organization per 24 hours; 0 turns the cap off

LOG_LEVEL=info
QUEUE_PREFIX=opsflow
WORKER_CONCURRENCY=5
DB_POOL_MAX=10
SHUTDOWN_TIMEOUT_MS=10000

# --- Web app (build time, not runtime) ---
# Public https address of the API. The Next.js server proxies /api/* to it, which keeps the
# session cookie first-party. Changing it requires rebuilding the web image.
# API_URL=https://your-api.example.com
