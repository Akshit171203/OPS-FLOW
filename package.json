{
  "name": "opsflow",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @opsflow/backend dev",
    "dev:worker": "pnpm --filter @opsflow/backend dev:worker",
    "dev:frontend": "pnpm --filter @opsflow/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @opsflow/backend test",
    "db:generate": "pnpm --filter @opsflow/backend db:generate",
    "db:migrate": "pnpm --filter @opsflow/backend db:migrate",
    "db:seed": "pnpm --filter @opsflow/backend db:seed",
    "demo:shop": "node examples/demo-shop/server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
